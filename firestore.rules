rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Price list (must match PRICES in js/firebase.js)
    function priceOf(house) {
      return {'cottage': 2000, 'treehouse': 2500, 'traditional': 3000, 'modern': 4000}[house];
    }

    // Everyone can see who owns which house. A house can be bought once.
    match /plots/{plotId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerId', 'ownerName', 'house', 'price', 'boughtAt'])
        && request.resource.data.price == priceOf(request.resource.data.house)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.plotId == plotId;
      // Only the owner can change who lives there (members), nothing else.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds'])
        && request.resource.data.get('memberIds', []).size() <= 6;
      allow delete: if false;
    }

    // "Can I enter your house?" requests. Only the asker and the owner can see them.
    match /requests/{reqId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && reqId == request.resource.data.plotId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['plotId', 'ownerId', 'fromUid', 'fromName', 'createdAt'])
        && get(/databases/$(database)/documents/plots/$(request.resource.data.plotId)).data.ownerId == request.resource.data.ownerId;
      allow delete: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow update: if false;
    }

    // Each player's wallet. Only that player can see it.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // New player: starting coins, no house yet.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['coins', 'plotId'])
        && request.resource.data.coins == 5000
        && request.resource.data.plotId == null;

      // Buying a house: the coins go down by exactly the price, and only once.
      allow update: if request.auth != null && request.auth.uid == uid
        && resource.data.plotId == null
        && request.resource.data.keys().hasOnly(['coins', 'plotId'])
        && request.resource.data.plotId is string
        && request.resource.data.coins is int
        && request.resource.data.coins >= 0
        && getAfter(/databases/$(database)/documents/plots/$(request.resource.data.plotId)).data.ownerId == request.auth.uid
        && request.resource.data.coins == resource.data.coins
             - getAfter(/databases/$(database)/documents/plots/$(request.resource.data.plotId)).data.price;

      allow delete: if false;
    }
  }
}
